{{- $directory := requiredEnv "TAMOSS_ENV_DIR" -}}
{{- $dependencies := readFile "../../dependencies.yaml" | fromYaml -}}
helmDefaults:
  wait: true
  timeout: 1400
releases:
  - name: retirement
    namespace: tamoss-infra
    chart: ../../charts/retirement
    values:
      - verifySecrets: false
        oracle:
          region: {{ (readFile (printf "%s/identity.yaml" $directory) | fromYaml).environment.region | quote }}
        images:
          oci: {{ $dependencies.oci.image | quote }}
          kubectl: {{ $dependencies.connectionDetails.kubectlImage | quote }}
      - {{ printf "%s/retirement-values.yaml" $directory | quote }}
