{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "deploymentId",
    "region",
    "vaultId",
    "databaseAdministrator",
    "dependencies",
    "packages",
    "externalSecrets"
  ],
  "properties": {
    "deploymentId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "region": {
      "type": "string",
      "pattern": "^[a-z]+-[a-z]+-[0-9]+$"
    },
    "vaultId": {
      "type": "string",
      "pattern": "^ocid1\\.vault\\.[a-z0-9.-]+$"
    },
    "databaseAdministrator": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,62}$"
    },
    "dependencies": {
      "type": "object",
      "required": [
        "crossplane",
        "externalSecrets",
        "platform",
        "calicoCommit"
      ]
    },
    "packages": {
      "type": "object",
      "required": [
        "providerVersion",
        "functions"
      ]
    },
    "externalSecrets": {
      "type": "object"
    },
    "gitops": {
      "type": "object",
      "properties": {"enabled": {"type": "boolean"}},
      "additionalProperties": false
    }
  }
}
