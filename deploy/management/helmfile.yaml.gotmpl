{{- $selection := dict "dependencies" (readFile "../../dependencies.yaml" | fromYaml) "packages" (readFile "../../charts/packages/values.yaml" | fromYaml) -}}
{{- $packages := mergeOverwrite (deepCopy $selection.packages) (dict "family" false "services" false "foundation" false "okeWorkloadIdentity" (dict "region" "")) -}}
repositories:
  - name: crossplane-stable
    url: https://charts.crossplane.io/stable
helmDefaults:
  wait: true
  timeout: 600
releases:
  - name: crossplane
    namespace: crossplane-system
    chart: crossplane-stable/crossplane
    version: {{ $selection.dependencies.crossplane.version | quote }}
    labels:
      stage: crossplane
  - name: oci-family
    namespace: crossplane-system
    chart: ../../charts/packages
    labels:
      stage: family
    values:
      - {{ $packages | toJson }}
      - family: true
  - name: oci-services
    namespace: crossplane-system
    chart: ../../charts/packages
    labels:
      stage: services
    values:
      - {{ $packages | toJson }}
      - services: true
  - name: tamoss-environment-api
    namespace: crossplane-system
    chart: ../../charts/environment
    labels:
      stage: api
