{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "compartmentId", "contactEmail", "adminCidrs"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,21}[a-z0-9]$"},
    "compartmentId": {"type": "string", "pattern": "^ocid1\\.compartment\\."},
    "contactEmail": {"type": "string", "format": "email"},
    "owner": {"type": "string"},
    "acmeEmail": {"type": "string"},
    "adminEmail": {"type": "string"},
    "adminCidrs": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "pattern": "^[0-9.]+/([1-9]|[12][0-9]|3[0-2])$"}},
    "product": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "url": {"type": "string", "pattern": "^https://github\\.com/[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+$"},
        "commit": {"type": "string", "pattern": "^$|^[a-f0-9]{40}$"}
      }
    },
    "network": {"type": "object", "additionalProperties": false, "properties": {
      "vcn": {"type": "string"}, "api": {"type": "string"}, "workers": {"type": "string"},
      "pods": {"type": "string"}, "database": {"type": "string"}, "loadBalancer": {"type": "string"}, "services": {"type": "string"}
    }},
    "oke": {"type": "object", "additionalProperties": false, "properties": {
      "version": {"type": "string", "pattern": "^v1\\.36\\.[0-9]+$"},
      "imageName": {"type": "string"}, "imageId": {"type": "string"}, "shape": {"type": "string"},
      "ocpus": {"type": "integer", "minimum": 2}, "memoryGiB": {"type": "integer", "minimum": 16},
      "placements": {"type": "array", "maxItems": 3, "items": {"type": "object", "additionalProperties": false,
        "required": ["availabilityDomain", "faultDomain"], "properties": {
          "availabilityDomain": {"type": "string"}, "faultDomain": {"enum": ["FAULT-DOMAIN-1", "FAULT-DOMAIN-2", "FAULT-DOMAIN-3"]}
        }}}
    }},
    "database": {"type": "object", "additionalProperties": false, "properties": {
      "version": {"type": "string"}, "shape": {"type": "string"}, "ocpus": {"type": "integer", "minimum": 1},
      "memoryGiB": {"type": "integer", "minimum": 8}, "administrator": {"type": "string"},
      "regionalStorage": {"type": "boolean"}, "availabilityDomain": {"type": "string"},
      "backupRetentionDays": {"type": "integer", "minimum": 1, "maximum": 35}
    }},
    "storage": {"type": "object", "additionalProperties": false, "properties": {"bucket": {"type": "string"}}},
    "foundation": {"type": "object", "additionalProperties": false, "properties": {
      "name": {"type": "string"}, "adoption": {"type": "object"}
    }},
    "bundles": {"type": "object"},
    "discovery": {"type": "object"}
  }
}
