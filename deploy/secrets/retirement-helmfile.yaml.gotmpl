helmDefaults:
  wait: true
  timeout: 240
releases:
  - name: secret-retirement
    namespace: tamoss-infra
    chart: ../../charts/secret-retirement
    values:
      - {{ requiredEnv "TAMOSS_ENV_DIR" }}/secret-store.yaml
      - images:
          oci: {{ (readFile "../oci/compose.yaml" | fromYaml).services.oci.image | quote }}
          yq: {{ (readFile "../../dependencies.yaml" | fromYaml).connectionDetails.yqImage | quote }}
