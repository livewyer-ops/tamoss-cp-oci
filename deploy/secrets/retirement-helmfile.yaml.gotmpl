{{- $directory := requiredEnv "TAMOSS_ENV_DIR" -}}
{{- $identity := readFile (printf "%s/identity.yaml" $directory) | fromYaml -}}
{{- $foundation := readFile (printf "%s/foundation-record.yaml" $directory) | fromYaml -}}
helmDefaults:
  wait: true
  timeout: 240
releases:
  - name: secret-retirement
    namespace: tamoss-infra
    chart: ../../charts/secret-retirement
    values:
      - deploymentId: {{ $identity.deploymentUID | quote }}
        oracle:
          region: {{ $foundation.region | quote }}
          vault: {{ $foundation.vaultId | quote }}
          compartment: {{ $foundation.compartmentId | quote }}
          auth:
            user: {{ $identity.oci.user | quote }}
            tenancy: {{ $identity.oci.tenancy | quote }}
      - images:
          oci: {{ (readFile "../../dependencies.yaml" | fromYaml).oci.image | quote }}
          yq: {{ (readFile "../../dependencies.yaml" | fromYaml).connectionDetails.yqImage | quote }}
