{{- $xr := .observed.composite.resource -}}
{{- $p := $xr.spec -}}
{{- if and (hasKey $p "storageCredentials") (not (hasKey $p "vaultAuth")) -}}
{{- fail "Automatic storage identity requires the Kind provisioner" -}}
{{- end -}}
{{- $storageJobs := dig "storageJobs" "items" (list) (.extraResources | default dict) -}}
{{- $storagePods := dig "storagePods" "items" (list) (.extraResources | default dict) -}}
{{- $secretDefaults := fromJson __SECRET_VALUES__ -}}
{{- $secretRelease := (get .observed.resources "secrets" | default dict).resource | default dict -}}
{{- $storageRetired := or (not (hasKey $p "storageCredentials")) (empty $secretRelease) -}}
{{- range (dig "status" "conditions" (list) $secretRelease) -}}
{{- if and (eq .type "Ready") (eq .status "True") (not (dig "spec" "values" "initialise" true $secretRelease)) (eq (dig "status" "observedGeneration" 0 $secretRelease) (dig "metadata" "generation" -1 $secretRelease)) -}}{{- $storageRetired = true -}}{{- end -}}
{{- end -}}
{{- $accessRelease := (get .observed.resources "runtime-access" | default dict).resource | default dict -}}
{{- $foundation := (get .observed.resources "foundation" | default dict).resource | default dict -}}
{{- $environment := (get .observed.resources "environment" | default dict).resource | default dict -}}
{{- if and $environment (ne (index $environment.metadata.annotations "tamoss.livewyer.io/deployment-id") $p.deploymentId) -}}
{{- fail "Observed environment belongs to a different deployment" -}}
{{- end -}}
{{- $foundationReady := false -}}
{{- range (dig "status" "conditions" (list) $foundation) -}}
{{- if and (eq .type "Ready") (eq .status "True") -}}{{- $foundationReady = true -}}{{- end -}}
{{- end -}}
{{- $foundationReady = and $foundationReady (ne (dig "status" "vaultId" "" $foundation) "") (ne (dig "status" "keyId" "" $foundation) "") -}}
{{- $credentialsReady := false -}}
{{- range (dig "credentials" "items" (list) (.extraResources | default dict)) -}}
{{- $secret := .resource -}}
{{- $matches := and (eq (dig "spec" "target" "name" "" $secret) "database-admin") (eq (dig "spec" "secretStoreRef" "name" "" $secret) "tamoss-vault") (eq (dig "spec" "secretStoreRef" "kind" "SecretStore" $secret) "SecretStore") -}}
{{- $bound := false -}}
{{- range (dig "spec" "data" (list) $secret) -}}
{{- if and (eq .secretKey "password") (eq .remoteRef.key (printf "%s-database-admin" $p.deploymentId)) -}}{{- $bound = true -}}{{- end -}}
{{- end -}}
{{- range (dig "status" "conditions" (list) $secret) -}}
{{- if and $matches $bound (eq .type "Ready") (eq .status "True") -}}{{- $credentialsReady = true -}}{{- end -}}
{{- end -}}
{{- end -}}
{{- $infrastructureReady := false -}}
{{- range (dig "status" "conditions" (list) $environment) -}}
{{- if and (eq .type "Ready") (eq .status "True") -}}{{- $infrastructureReady = true -}}{{- end -}}
{{- end -}}
{{- $accessReady := not (hasKey $p "vaultAuth") -}}
{{- $bindingInput := dict -}}
{{- $bindingReadback := dict -}}
{{- range (dig "bindingInput" "items" (list) (.extraResources | default dict)) -}}{{- $bindingInput = .resource -}}{{- end -}}
{{- range (dig "bindingReadback" "items" (list) (.extraResources | default dict)) -}}{{- $bindingReadback = .resource -}}{{- end -}}
{{- if and $bindingInput (or (ne (dig "data" "DEPLOYMENT_ID" "" $bindingInput) (b64enc $p.deploymentId)) (ne (dig "data" "CREATION_COMPOSITE_UID" "" $bindingInput) (b64enc (dig "metadata" "uid" "" $environment)))) -}}
{{- fail "Adoption snapshot does not belong to the original environment" -}}
{{- end -}}
{{- $bindingsReady := and (not (empty $bindingInput)) (not (empty $bindingReadback)) (eq (toJson $bindingInput.data) (toJson $bindingReadback.data)) -}}
{{- if and $bindingReadback $bindingInput (not $bindingsReady) -}}{{- fail "Vault adoption bindings differ from the original infrastructure snapshot" -}}{{- end -}}
{{- range (dig "status" "conditions" (list) $accessRelease) -}}
{{- if and (eq .type "Ready") (eq .status "True") (eq (dig "status" "observedGeneration" 0 $accessRelease) ($accessRelease.metadata.generation | default 0)) -}}{{- $accessReady = true -}}{{- end -}}
{{- end -}}
{{- if hasKey $p "vaultAuth" -}}
{{- $policies := dig "runtimePolicies" "items" (list) (.extraResources | default dict) -}}
{{- $accessReady = and $accessReady (eq (len $policies) 10) -}}
{{- range $policies -}}
{{- $ready := false -}}{{- $synced := false -}}
{{- range (dig "status" "conditions" (list) .resource) -}}
{{- if and (eq .type "Ready") (eq .status "True") -}}{{- $ready = true -}}{{- end -}}
{{- if and (eq .type "Synced") (eq .status "True") -}}{{- $synced = true -}}{{- end -}}
{{- end -}}
{{- $accessReady = and $accessReady $ready $synced -}}
{{- end -}}
{{- end -}}
__STORAGE_IDENTITY__
apiVersion: meta.gotemplating.fn.crossplane.io/v1alpha1
kind: ExtraResources
requirements:
{{- if hasKey $p "storageCredentials" }}
  storageJobs:
    apiVersion: batch/v1
    kind: Job
    namespace: {{ $xr.metadata.namespace }}
    matchLabels:
      tamoss.livewyer.io/credential-operation: s3
      tamoss.livewyer.io/deployment-id: {{ $p.deploymentId | quote }}
  storagePods:
    apiVersion: v1
    kind: Pod
    namespace: {{ $xr.metadata.namespace }}
    matchLabels:
      tamoss.livewyer.io/credential-operation: s3
      tamoss.livewyer.io/deployment-id: {{ $p.deploymentId | quote }}
{{- end }}
  runtimePolicies:
    apiVersion: identity.oci.m.upbound.io/v1alpha1
    kind: Policy
    namespace: {{ $xr.metadata.namespace }}
    matchLabels:
      tamoss.livewyer.io/deployment-id: {{ $p.deploymentId | quote }}
      tamoss.livewyer.io/iam-role: runtime
  bindingInput:
    apiVersion: v1
    kind: Secret
    namespace: {{ $xr.metadata.namespace }}
    matchName: adoption-bindings-input
  bindingReadback:
    apiVersion: v1
    kind: Secret
    namespace: {{ $xr.metadata.namespace }}
    matchName: adoption-bindings
  credentials:
    apiVersion: external-secrets.io/v1
    kind: ExternalSecret
    namespace: {{ $xr.metadata.namespace }}
    matchName: database-admin
{{- if hasKey $p "remoteBootstrap" }}
  remotePods:
    apiVersion: v1
    kind: Pod
    namespace: {{ $xr.metadata.namespace }}
    matchLabels:
      tamoss.livewyer.io/bootstrap: oke
      tamoss.livewyer.io/deployment-id: {{ $p.deploymentId | quote }}
  remoteCredentials:
    apiVersion: external-secrets.io/v1
    kind: ExternalSecret
    namespace: {{ $xr.metadata.namespace }}
    matchLabels: {tamoss.livewyer.io/credential: 'true'}
{{- end }}
---
apiVersion: tamoss.livewyer.io/v1alpha1
kind: SecretFoundation
metadata:
  name: {{ $p.foundationName }}
  namespace: {{ $xr.metadata.namespace }}
  annotations:
    {{ setResourceNameAnnotation "foundation" }}
    gotemplating.fn.crossplane.io/ready: {{ $foundationReady | toString | title | quote }}
spec:
{{ $p.foundation | toYaml | indent 2 }}
{{- if hasKey $p "vaultAuth" }}
{{- $vault := dig "status" "vaultId" "" $foundation | default (dig "spec" "values" "oracle" "vault" "" $secretRelease) -}}
{{- $key := dig "status" "keyId" "" $foundation | default (dig "spec" "values" "oracle" "encryptionKey" "" $secretRelease) -}}
{{- if and $vault $key (or $storageIdentityReady $secretRelease (not (hasKey $p "storageCredentials"))) }}
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: tamoss-secrets
  namespace: {{ $xr.metadata.namespace }}
  annotations:
    {{ setResourceNameAnnotation "secrets" }}
    gotemplating.fn.crossplane.io/ready: {{ $credentialsReady | toString | title | quote }}
spec:
  interval: 1m
  timeout: 5m
  releaseName: tamoss-secrets
  install:
    disableWaitForJobs: true
    strategy: {name: RetryOnFailure, retryInterval: 30s}
  upgrade:
    disableWaitForJobs: true
    strategy: {name: RetryOnFailure, retryInterval: 30s}
  chart:
    spec:
      chart: ./charts/secrets
      reconcileStrategy: Revision
      sourceRef: {kind: GitRepository, name: tamoss-bootstrap-product}
  values:
{{ $secretDefaults | toYaml | indent 4 }}
    deploymentId: {{ $p.deploymentId | quote }}
    initialise: {{ and (not $p.released) (not ($p.credentialsEstablished | default false)) }}
{{- with $p.storageCredentials }}
    s3:
      userId: {{ $storageUserId | quote }}
      image: {{ .image | quote }}
{{- end }}
    oracle:
      region: {{ $p.foundation.region | quote }}
      vault: {{ $vault | quote }}
      encryptionKey: {{ $key | quote }}
      compartment: {{ $p.foundation.compartmentId | quote }}
      principalType: UserPrincipal
      auth:
        user: {{ $p.vaultAuth.user | quote }}
        tenancy: {{ $p.vaultAuth.tenancy | quote }}
        secretRef:
          privatekey: {name: oci-vault-bootstrap, key: privatekey}
          fingerprint: {name: oci-vault-bootstrap, key: fingerprint}
{{- end }}
{{- $cluster := dig "status" "outputs" "clusterId" "" $environment | default (dig "spec" "values" "clusterId" "" $accessRelease) -}}
{{- if and $vault $cluster }}
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: runtime-access
  namespace: {{ $xr.metadata.namespace }}
  annotations:
    {{ setResourceNameAnnotation "runtime-access" }}
    gotemplating.fn.crossplane.io/ready: {{ $accessReady | toString | title | quote }}
spec:
  interval: 1m
  timeout: 5m
  releaseName: runtime-access
  install:
    strategy: {name: RetryOnFailure, retryInterval: 30s}
  upgrade:
    strategy: {name: RetryOnFailure, retryInterval: 30s}
  chart:
    spec:
      chart: ./charts/runtime-access
      reconcileStrategy: Revision
      sourceRef: {kind: GitRepository, name: tamoss-bootstrap-product}
  values:
    deploymentId: {{ $p.deploymentId | quote }}
    compartmentId: {{ $p.environment.compartmentId | quote }}
    providerConfigName: {{ $p.environment.providerConfigName | quote }}
    clusterId: {{ $cluster | quote }}
    vaultId: {{ $vault | quote }}
    bucket: {{ $p.environment.storage.bucket | quote }}
    providerWrites: false
{{- end }}
{{- end }}
{{- if $bindingInput }}
---
apiVersion: external-secrets.io/v1alpha1
kind: PushSecret
metadata:
  name: adoption-bindings
  namespace: {{ $xr.metadata.namespace }}
  annotations:
    {{ setResourceNameAnnotation "binding-persistence" }}
    gotemplating.fn.crossplane.io/ready: {{ $bindingsReady | toString | title | quote }}
spec:
  updatePolicy: IfNotExists
  deletionPolicy: None
  refreshInterval: 1m
  secretStoreRefs: [{name: tamoss-vault, kind: SecretStore}]
  selector:
    secret: {name: adoption-bindings-input}
  data:
    - match:
        remoteRef: {remoteKey: {{ printf "%s-adoption-bindings" $p.deploymentId | quote }}}
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: adoption-bindings
  namespace: {{ $xr.metadata.namespace }}
  annotations:
    {{ setResourceNameAnnotation "binding-readback" }}
    gotemplating.fn.crossplane.io/ready: {{ $bindingsReady | toString | title | quote }}
spec:
  refreshPolicy: Periodic
  refreshInterval: 1m
  secretStoreRef: {name: tamoss-vault, kind: SecretStore}
  target:
    name: adoption-bindings
    creationPolicy: Owner
    deletionPolicy: Retain
  dataFrom:
    - extract: {key: {{ printf "%s-adoption-bindings" $p.deploymentId | quote }}}
{{- end }}
{{- if or $environment (not $p.released) }}
{{- $spec := $p.environment -}}
{{- if $p.released -}}
{{- $spec = omit $environment.spec "crossplane" -}}
{{- end }}
---
apiVersion: tamoss.livewyer.io/v1alpha1
kind: TamossEnvironment
metadata:
  name: {{ $xr.metadata.name }}
  namespace: {{ $xr.metadata.namespace }}
  annotations:
    {{ setResourceNameAnnotation "environment" }}
    tamoss.livewyer.io/deployment-id: {{ $p.deploymentId | quote }}
    gotemplating.fn.crossplane.io/ready: {{ $infrastructureReady | toString | title | quote }}
spec:
{{ $spec | toYaml | indent 2 }}
{{- end }}
__REMOTE_BOOTSTRAP__
---
apiVersion: {{ $xr.apiVersion }}
kind: {{ $xr.kind }}
metadata:
  annotations:
    gotemplating.fn.crossplane.io/ready: {{ (and $foundationReady $credentialsReady $storageIdentityReady $infrastructureReady $accessReady (or (not (hasKey $p "vaultAuth")) $bindingsReady) $remoteReady) | toString | title | quote }}
status:
  observedGeneration: {{ $xr.metadata.generation | default 1 }}
  foundationReady: {{ $foundationReady }}
  credentialsReady: {{ $credentialsReady }}
  storageIdentityReady: {{ $storageIdentityReady }}
  storageIdentity:
    userId: {{ $storageUserId | quote }}
    groupId: {{ $storageGroupId | quote }}
  infrastructureReady: {{ $infrastructureReady }}
  bootstrapReady: {{ and (dig "status" "bootstrapReady" false $environment) $accessReady ($p.credentialsEstablished | default false) }}
  bindingsReady: {{ $bindingsReady }}
  runtimeAccessReady: {{ $accessReady }}
  remoteBootstrapReady: {{ $remoteReady }}
  remoteBootstrapCompleted: {{ $remoteCompleted }}
  remoteBootstrapPhase: {{ $remotePhase | quote }}
  released: {{ and $p.released $storageRetired $storageQuiesced (eq (len $remotePods) 0) (empty $remoteJob) (eq (len $storagePods) 0) (eq (len $storageJobs) 0) }}
