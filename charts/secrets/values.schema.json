{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["deploymentId", "oracle", "initialise", "passwords", "imports", "deliveries"],
  "additionalProperties": false,
  "properties": {
    "deploymentId": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "initialise": {"type": "boolean"},
    "oracle": {
      "type": "object",
      "required": ["region", "vault", "principalType"],
      "additionalProperties": false,
      "properties": {
        "region": {"type": "string", "pattern": "^[a-z]+-[a-z]+-[0-9]+$"},
        "vault": {"type": "string", "pattern": "^ocid1\\.vault\\."},
        "compartment": {"type": "string", "pattern": "^ocid1\\.compartment\\."},
        "encryptionKey": {"type": "string", "pattern": "^ocid1\\.key\\."},
        "principalType": {"enum": ["UserPrincipal", "Workload"]},
        "serviceAccountRef": {
          "type": ["object", "null"], "required": ["name"], "additionalProperties": false,
          "properties": {"name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"}}
        },
        "auth": {
          "type": ["object", "null"], "required": ["user", "tenancy", "secretRef"], "additionalProperties": false,
          "properties": {
            "user": {"type": "string", "pattern": "^ocid1\\.user\\."},
            "tenancy": {"type": "string", "pattern": "^ocid1\\.tenancy\\."},
            "secretRef": {
              "type": "object", "required": ["privatekey", "fingerprint"], "additionalProperties": false,
              "properties": {
                "privatekey": {"$ref": "#/definitions/secretRef"},
                "fingerprint": {"$ref": "#/definitions/secretRef"}
              }
            }
          }
        }
      },
      "allOf": [
        {"if": {"properties": {"principalType": {"const": "Workload"}}}, "then": {"required": ["serviceAccountRef"], "properties": {"serviceAccountRef": {"type": "object"}, "auth": {"type": "null"}}}},
        {"if": {"properties": {"principalType": {"const": "UserPrincipal"}}}, "then": {"required": ["auth"], "properties": {"auth": {"type": "object"}, "serviceAccountRef": {"type": "null"}}}}
      ]
    },
    "s3": {"type": ["object", "null"], "required": ["userId", "images"], "additionalProperties": false,
      "properties": {
        "userId": {"type": "string", "pattern": "^ocid1\\.user\\."},
        "images": {"type": "object", "required": ["oci", "kubectl"], "additionalProperties": false,
          "properties": {
            "oci": {"type": "string", "pattern": "^[a-z0-9.-]+/[a-zA-Z0-9/_.:-]+@sha256:[a-f0-9]{64}$"},
            "kubectl": {"type": "string", "pattern": "^[a-z0-9.-]+/[a-zA-Z0-9/_.:-]+@sha256:[a-f0-9]{64}$"}
          }
        }
      }
    },
    "operation-common": {"type": "object"},
    "global": {"type": "object"},
    "passwords": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/name"}},
    "imports": {
      "type": "array", "items": {
        "type": "object", "required": ["name", "sourceSecret"], "additionalProperties": false,
        "properties": {"name": {"$ref": "#/definitions/name"}, "sourceSecret": {"$ref": "#/definitions/name"}}
      }
    },
    "deliveries": {
      "type": "array", "items": {
        "type": "object", "required": ["name", "data"], "additionalProperties": false,
        "properties": {
          "name": {"$ref": "#/definitions/name"},
          "type": {"enum": ["Opaque", "kubernetes.io/dockerconfigjson"]},
          "template": {"type": "object", "additionalProperties": {"type": "string"}},
          "data": {"type": "array", "minItems": 1, "items": {
            "type": "object", "required": ["secretKey", "remoteKey"], "additionalProperties": false,
            "properties": {
              "secretKey": {"type": "string", "minLength": 1},
              "remoteKey": {"$ref": "#/definitions/name"},
              "property": {"type": "string", "minLength": 1}
            }
          }}
        }
      }
    }
  },
  "allOf": [{"if": {"properties": {"initialise": {"const": true}}}, "then": {"properties": {"oracle": {"required": ["compartment", "encryptionKey"], "properties": {"principalType": {"const": "UserPrincipal"}}}}}}],
  "definitions": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "secretRef": {"type": "object", "required": ["name", "key"], "additionalProperties": false, "properties": {"name": {"$ref": "#/definitions/name"}, "key": {"type": "string", "minLength": 1}}}
  }
}
